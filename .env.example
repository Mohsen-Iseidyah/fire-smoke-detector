# ---------------------------------------------------------------
# Copy to .env and fill in real values.  cp .env.example .env
# The .env file is git-ignored and must never be committed.
# ---------------------------------------------------------------

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# One or more recipients, comma separated.
# Group IDs are negative and start with -100.
TELEGRAM_CHAT_IDS=123456789,-1001234567890

# Detector mode override: mock | cpu | edgetpu
# Takes priority over detection.mode in config.yaml.
DETECTOR_MODE=mock

# Set to 1 to write alerts to logs/alerts/ instead of sending them.
ALERTS_DRY_RUN=1
